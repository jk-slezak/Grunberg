{
  "name": "grunberg",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @grunberg/web",
    "dev:api": "npm run dev --workspace @grunberg/api",
    "build": "npm run build --workspace @grunberg/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:types": "npm run lint:types --workspaces --if-present"
  }
}
